<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="CooldownReady.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:CooldownReady"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="CooldownReady">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>


    <!-- 타이틀 및 설정 저장 버튼 (상단) -->
    <Grid VerticalAlignment="Top" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ComboBox x:Name="LanguageComboBox"
        Grid.Column="0"
        Width="120"
        Height="28"
        FontSize="12"
        VerticalAlignment="Center"
        AutomationProperties.Name="언어"
        SelectionChanged="LanguageComboBox_SelectionChanged" />

      <ToggleButton x:Name="AlwaysOnTopToggleButton"
        Checked="AlwaysOnTopToggleButton_Checked"
        Unchecked="AlwaysOnTopToggleButton_Unchecked"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Width="28"
        Height="28"
        Grid.Column="2"
        Margin="0,0,10,0"
        Padding="6,6,0,0"
        ToolTipService.ToolTip="항상 위">
        <SymbolIcon Symbol="Pin">
          <SymbolIcon.RenderTransform>
            <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
          </SymbolIcon.RenderTransform>
        </SymbolIcon>
      </ToggleButton>

      <Button x:Name="SaveSettingsButton"
        Content="설정 저장"
        Click="SaveSettingsButton_Click"
        Width="100"
        Height="28"
        FontSize="12"
        CornerRadius="3"
        Grid.Column="3">

      </Button>
    </Grid>

    <StackPanel Spacing="20" HorizontalAlignment="Stretch" Grid.Row="1">
      <!-- 접을 수 있는 설정 섹션 -->
      <StackPanel x:Name="SettingsSection" Spacing="20" HorizontalAlignment="Stretch">
        <!-- 키보드 훅 설정 -->
        <StackPanel Spacing="10" HorizontalAlignment="Left">
          <TextBlock x:Name="MonitoringKeyLabel" Text="모니터링 키" FontSize="16" FontWeight="SemiBold" />
          <TextBox x:Name="KeyboardHookTextBox"
            PlaceholderText="여기를 눌러 키를 눌러주세요..."
            KeyDown="KeyboardHookTextBox_KeyDown"
            IsReadOnly="True"
            MaxLength="50"
            HorizontalAlignment="Left"
            FontSize="24"
            FontWeight="Black"
            Width="200" />
          <TextBlock x:Name="KeyboardHookDisplayText"
            Text="아직 키가 설정되지 않았습니다"
            Foreground="Red"
            FontSize="12"
            HorizontalAlignment="Left" />
        </StackPanel>

        <!-- IntervalSec 설정 (분, 초) -->
        <StackPanel Spacing="10" HorizontalAlignment="Left">
          <TextBlock x:Name="CooldownTimeLabel" Text="쿨다운 시간" FontSize="16" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
            <NumberBox x:Name="IntervalMinuteBox"
              Value="0"
              Minimum="0"
              Maximum="59"
              Width="150"
              PlaceholderText="분"
              SpinButtonPlacementMode="Inline" />
            <TextBlock x:Name="IntervalMinuteUnitText" Text="분" VerticalAlignment="Center" />
            <NumberBox x:Name="IntervalSecondBox"
              Value="30"
              Minimum="0"
              Maximum="59"
              Width="150"
              PlaceholderText="초"
              SpinButtonPlacementMode="Inline" />
            <TextBlock x:Name="IntervalSecondUnitText" Text="초" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- alertSec 설정 -->
        <StackPanel Spacing="10" HorizontalAlignment="Left">
          <TextBlock x:Name="AlertTimeLabel" Text="알림 시간 (초 전에 알림)" FontSize="16" FontWeight="SemiBold" />
          <NumberBox x:Name="AlertSecondBox"
            Value="5"
            Minimum="0"
            Maximum="300"
            Width="200"
            PlaceholderText="초"
            HorizontalAlignment="Left"
            SpinButtonPlacementMode="Inline" />
        </StackPanel>

        <!-- Alert Sound 선택 -->
        <StackPanel Spacing="10" HorizontalAlignment="Left">
          <TextBlock x:Name="AlertSoundLabel" Text="알림 소리 선택" FontSize="16" FontWeight="SemiBold" />
          <ComboBox x:Name="AlertSoundComboBox"
            Width="200"
            HorizontalAlignment="Left"
            SelectionChanged="AlertSoundComboBox_SelectionChanged">
          </ComboBox>
        </StackPanel>

        <!-- 중복 입력 방지 설정 -->
        <CheckBox x:Name="PreventDuplicateInputCheckBox"
          Content="카운트다운 중 중복 입력 방지"
          HorizontalAlignment="Left" />
      </StackPanel>

      <!-- 카운트다운 표시 -->
      <StackPanel Spacing="0" x:Name="CountdownPanel" HorizontalAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="RemainingTimeLabel"
            Text="남은 시간"
            FontSize="16"
            FontWeight="SemiBold"
            Grid.Column="0" />
          <Button x:Name="FoldSettingsButton"
            Content="▲ 설정접기"
            Click="FoldSettingsButton_Click"
            Width="120"
            Height="24"
            FontSize="12"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Grid.Column="2"
            Margin="10,0,0,0"
            CornerRadius="3"
            BorderThickness="1" />
        </Grid>

        <StackPanel HorizontalAlignment="Stretch" Spacing="10">
          <TextBlock x:Name="CountdownText"
            Text="00:00"
            FontSize="64"
            FontWeight="Bold"
            HorizontalAlignment="Center" />
          <Border x:Name="CountdownProgressBarContainer"
            Height="40"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            Background="#33000000"
            CornerRadius="5"
            SizeChanged="CountdownProgressBarContainer_SizeChanged">
            <Rectangle x:Name="CountdownProgressBar"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Fill="White"
              RadiusX="5"
              RadiusY="5" />
          </Border>
        </StackPanel>

      </StackPanel>
    </StackPanel>

    <!-- Start/Stop 버튼 (하단 고정) -->
    <StackPanel Spacing="0" Grid.Row="2" Margin="0,0,0,0">

      <Button x:Name="StartStopButton"
        Content="시작"
        Click="StartStopButton_Click"
        HorizontalAlignment="Stretch"
        Height="50"
        FontSize="18"
        FontWeight="SemiBold"
        Background="Green"
        Foreground="White"
        CornerRadius="3" />
    </StackPanel>
  </Grid>
</Window>
