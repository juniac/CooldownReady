<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="CooldownReady.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:CooldownReady"
  xmlns:controls="using:CooldownReady.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="CooldownReady">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="RootGrid"
    Margin="20"
    Background="Transparent"
    PointerPressed="RootGrid_PointerPressed">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 빈 영역 클릭 시 입력 상자 포커스를 옮겨받는 보이지 않는 대상 -->
    <Button x:Name="FocusSink"
      Width="1"
      Height="1"
      Padding="0"
      Opacity="0"
      IsTabStop="True"
      TabIndex="9999"
      IsHitTestVisible="False"
      HorizontalAlignment="Left"
      VerticalAlignment="Top" />

    <!-- 타이틀 및 설정 저장 버튼 (상단) -->
    <Grid VerticalAlignment="Top" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ComboBox x:Name="LanguageComboBox"
        Grid.Column="0"
        Width="120"
        Height="28"
        FontSize="12"
        VerticalAlignment="Center"
        SelectionChanged="LanguageComboBox_SelectionChanged" />

      <ToggleButton x:Name="AlwaysOnTopToggleButton"
        Checked="AlwaysOnTopToggleButton_Checked"
        Unchecked="AlwaysOnTopToggleButton_Unchecked"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Width="28"
        Height="28"
        Grid.Column="2"
        Margin="0,0,10,0"
        Padding="6,6,0,0">
        <SymbolIcon Symbol="Pin">
          <SymbolIcon.RenderTransform>
            <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
          </SymbolIcon.RenderTransform>
        </SymbolIcon>
      </ToggleButton>

      <Button x:Name="SaveSettingsButton"
        Click="SaveSettingsButton_Click"
        Width="100"
        Height="28"
        FontSize="12"
        CornerRadius="3"
        Grid.Column="3" />
    </Grid>

    <!-- 본문: 행이 많아지면 스크롤 -->
    <ScrollViewer Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="20" HorizontalAlignment="Stretch" Margin="0,0,4,0">
        <!-- 접을 수 있는 설정 섹션: 키 바인딩 행 목록 + 추가 버튼 -->
        <controls:SettingGroup x:Name="BindingsGroup"
          Visibility="Visible"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="10" HorizontalAlignment="Stretch">
            <StackPanel x:Name="BindingRowsPanel" Spacing="10" HorizontalAlignment="Stretch" />
            <Button x:Name="AddKeyButton"
              Click="AddKeyButton_Click"
              HorizontalAlignment="Stretch"
              Height="32"
              FontSize="14"
              CornerRadius="3" />
          </StackPanel>
        </controls:SettingGroup>

        <!-- 카운트다운 표시 -->
        <StackPanel Spacing="10" x:Name="CountdownPanel" HorizontalAlignment="Stretch">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RemainingTimeLabel"
              FontSize="16"
              FontWeight="SemiBold"
              Grid.Column="0" />
            <Button x:Name="FoldSettingsButton"
              Click="FoldSettingsButton_Click"
              Width="120"
              Height="24"
              FontSize="12"
              Padding="0"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Grid.Column="2"
              Margin="10,0,0,0"
              CornerRadius="3"
              BorderThickness="1" />
          </Grid>

          <StackPanel x:Name="CountdownListPanel" Spacing="10" HorizontalAlignment="Stretch" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Start/Stop 버튼 (하단 고정) -->
    <Button x:Name="StartStopButton"
      Grid.Row="2"
      Margin="0,10,0,0"
      Click="StartStopButton_Click"
      HorizontalAlignment="Stretch"
      Height="50"
      FontSize="18"
      FontWeight="SemiBold"
      Background="Green"
      Foreground="White"
      CornerRadius="3" />
  </Grid>
</Window>
