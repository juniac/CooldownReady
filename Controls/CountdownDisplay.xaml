<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="CooldownReady.Controls.CountdownDisplay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

  <!-- [키 라벨 = 진행바 배경][남은 초(최대 999)] -->
  <Grid ColumnSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Border x:Name="BarContainer"
      Grid.Column="0"
      Height="36"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Center"
      Background="#33000000"
      CornerRadius="5"
      SizeChanged="BarContainer_SizeChanged">
      <Grid>
        <Rectangle x:Name="ProgressBar"
          HorizontalAlignment="Left"
          VerticalAlignment="Stretch"
          Fill="{ThemeResource TextFillColorPrimaryBrush}"
          Opacity="0.35"
          RadiusX="5"
          RadiusY="5" />
        <Rectangle x:Name="AlertMarker"
          Width="2"
          HorizontalAlignment="Left"
          VerticalAlignment="Stretch"
          Fill="{ThemeResource TextFillColorPrimaryBrush}"
          Opacity="0.7"
          Visibility="Collapsed" />
        <TextBlock x:Name="KeyNameText"
          Text="—"
          Margin="10,0"
          FontSize="16"
          FontWeight="SemiBold"
          VerticalAlignment="Center" />
      </Grid>
    </Border>

    <TextBlock x:Name="SecondsText"
      Grid.Column="1"
      Text="0"
      MinWidth="58"
      TextAlignment="Right"
      FontSize="28"
      FontWeight="Bold"
      VerticalAlignment="Center" />
  </Grid>
</UserControl>
